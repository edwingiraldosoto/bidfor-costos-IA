VITE_SUPABASE_URL=https://tuproyecto-personal.supabase.co
VITE_SUPABASE_ANON_KEY=tuapikeydesupabasedelproyecto

# ═══════════════════════════════════════════════════════════════════════════════
# ANÁLISIS DE FACTURAS - 100% PARAMETRIZABLE
# ═══════════════════════════════════════════════════════════════════════════════
# Cambia solo estas variables para usar cualquier proveedor y comportamiento.
# Todo está centralizado aquí. Nada quemado en el código.
# ═══════════════════════════════════════════════════════════════════════════════

# 1. CLAVE API (misma variable para TODOS los proveedores - agnóstica)
# ────────────────────────────────────────────────────────────────────────────
# IMPORTANTE: Esta es la ÚNICA clave API que necesitas
# - Frontend (VITE) usa: VITE_API_KEY_IA
# - Backend (proxy.mjs) usa: VITE_API_KEY_IA (automáticamente)
#
# Funciona con: Anthropic, Google Gemini, OpenAI
# Solo cambia esta clave y VITE_PROVEEDOR_ID para cambiar de proveedor
# NO necesitas cambiar el código
#
# Obtén tu clave según tu proveedor:
# - Anthropic: https://console.anthropic.com/api_keys
# - Google:    https://aistudio.google.com/app/apikey
# - OpenAI:    https://platform.openai.com/api-keys
VITE_API_KEY_IA=sk-TUAPI-KEY-DE-IA-QUE-USA

# Puerto para servidor backend
PORT=3001

# 2. MOTORES/MODELOS (separados por comas, reintentos automáticos)
# ────────────────────────────────────────────────────────────────────────────
# Formato: motor1,motor2,motor3
# Si motor1 falla (ocupado, timeout, error) → intenta motor2 → intenta motor3
#
# ORDEN: MÁS ECONÓMICO+POTENTE → MÁS CARO+POTENTE (optimiza costos)
# Comienza con el modelo más barato. Si falla, sube automáticamente a premium.
#
# Anthropic Claude (RECOMENDADO - funciona 100% ✓):
#   claude-sonnet-4-6                 → mejor calidad, rápido ✓ (ACTUAL)
#   claude-opus-4-1                   → máxima calidad
#   claude-3-5-sonnet-20241022        → buena calidad alternativa
# 💡 Recomendado: claude-sonnet-4-6,claude-opus-4-1
#
# Google Gemini (alternativa - si obtienes clave nueva):
#   gemini-pro      → económico
#   gemini-1.5-pro  → alta calidad
# 💡 Recomendado: gemini-pro,gemini-1.5-pro
#
# OpenAI (alternativa):
#   gpt-4o-mini     → económico
#   gpt-4o          → buena calidad
#   gpt-4-turbo     → mejor calidad
# 💡 Recomendado: gpt-4o-mini,gpt-4o
VITE_MOTOR_IA=claude-sonnet-4-6,claude-opus-4-1

# 3. TEMPERATURA (controla el determinismo vs creatividad)
# ────────────────────────────────────────────────────────────────────────────
# Rango: 0.0 - 2.0
#
# 0.0       = Completamente determinista (mismo PDF = resultado idéntico)
# 0.1       = Muy consistente ← RECOMENDADO PARA FACTURAS
# 0.3-0.5   = Consistente con variedad
# 0.7-1.0   = Balanceado
# 1.0+      = Creativo (respuestas variadas)
# 1.5-2.0   = Muy aleatorio ← NO RECOMENDADO para datos estructurados
#
# Para análisis de facturas: usa 0.1 (máxima consistencia)
VITE_TEMPERATURA_IA=0.1

# 4. IDENTIFICADOR DEL PROVEEDOR
# ────────────────────────────────────────────────────────────────────────────
# Valores permitidos: google, anthropic, openai
VITE_PROVEEDOR_ID=anthropic

# 5. PROMPT PERSONALIZADO
# ────────────────────────────────────────────────────────────────────────────
# 💡 CAMBIAR ESTO EN PRODUCCIÓN NO REQUIERE REDEPLOYMENT
# Edita directamente aquí. Usa este prompt o crea uno personalizado.
VITE_PROMPT_FACTURA=Analiza esta factura en formato PDF y extrae la siguiente información en JSON: { "numero_factura": "string (número de la factura)", "nombre_proveedor": "string (nombre de la empresa/proveedor)", "nit_proveedor": "string (NIT o ID fiscal del proveedor)", "email_proveedor": "string o null", "telefono_proveedor": "string o null", "fecha_emision": "YYYY-MM-DD", "fecha_vencimiento": "YYYY-MM-DD", "valor_antes_iva": "number (El valor total a pagar de la factura MENOS el valor_iva sumado)", "porcentaje_iva": "number o string (Si hay múltiples porcentajes como en supermercados pon 'custom', de lo contrario 0, 5 o 19)", "valor_iva": "number (La suma total de todos los IVAs cobrados)", "aplica_retencion": "boolean", "valor_retencion": "number (0 si no aplica)" } IMPORTANTE: - Si algún campo no está disponible, usa null - Los valores deben ser números sin símbolos ($, ., ,) - Las fechas en formato YYYY-MM-DD - Si es una factura de contado o no tiene fecha de vencimiento, usa la misma fecha de emisión para fecha_vencimiento - Si hay múltiples fechas, usa la de vencimiento para fecha_vencimiento - Devuelve SOLO el JSON, sin explicaciones adicionales

